{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"schedule:weekdays"
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["^\\.github/workflows/actionlint\\.ya?ml$"],
			"matchStrings": ["ACTIONLINT_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
			"datasourceTemplate": "github-releases",
			"depNameTemplate": "rhysd/actionlint",
			"extractVersionTemplate": "^v(?<version>.*)$",
			"versioningTemplate": "semver"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["^\\.github/workflows/actionlint\\.ya?ml$"],
			"matchStrings": ["PYFLAKES_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
			"datasourceTemplate": "pypi",
			"depNameTemplate": "pyflakes"
		}
	],
	"packageRules": [
		{
			"matchManagers": ["github-actions"],
			"matchUpdateTypes": ["major", "minor", "patch"],
			"automerge": false,
			"minimumReleaseAge": "5 days"
		},
		{
			"matchDepNames": ["bridgecrewio/checkov-action"],
			"overrideDatasource": "git-refs",
			"overridePackageName": "https://github.com/bridgecrewio/checkov-action"
		},
		{
			"matchDepNames": ["rhysd/actionlint", "pyflakes"],
			"minimumReleaseAge": "3 days"
		}
	],
	"prConcurrentLimit": 3,
	"prHourlyLimit": 2,
	"labels": ["dependencies"]
}
